# ============================================================
# AdkCars CI - variables d'environnement du developpement local
#
# Ne jamais versionner un .ENV reel. Copier ce fichier en .env :
#   cp .env.example .env   (ou Copy-Item sur Windows)
#
# Les valeurs ci-dessous sont des valeurs de developpement.
# En production, toutes les valeurs SECREtes proviennent d'un
# coffre de secrets (CDCS 12.4).
# ============================================================

# ---- Application -------------------------------------------
NODE_ENV=development
PORT=3000
APP_NAME=@adkcars/api
APP_VERSION=0.1.0
# prefixe de l'API dans les journaux structures
LOG_PREFIX=[api]

# ---- Base de donnees (portable locale, cf. scripts/dev-db.ps1)
# DATABASE_URL : role restreint utilise par l'application (CDCS 12.1)
DATABASE_URL="postgresql://adkcars:adkcars_dev@127.0.0.1:5432/adkcars_dev?schema=public&connection_limit=10&pool_timeout=20"
# DIRECT_DATABASE_URL : role privilegie, utilise UNIQUEMENT par les migrations
# (necessite CREATE EXTENSION). Ne jamais l'utiliser dans le code applicatif.
DIRECT_DATABASE_URL="postgresql://postgres:adkcars_dev@127.0.0.1:5432/adkcars_dev?schema=public"

# ---- Supabase en production (A-18) ---------------------------
# En production, deux chaines distinctes, et c'est la separation qui
# compte :
#
#   DATABASE_URL          -> pooler en mode TRANSACTION, port 6543
#                            Utilise par l'application. Une transaction
#                            par connexion physique : c'est ce qui permet
#                            de servir plusieurs invocations sans saturer
#                            la base.
#
#   DIRECT_DATABASE_URL   -> connexion directe, port 5432
#                            Utilisee par les migrations uniquement. Le
#                            mode transaction ne permet ni advisory lock
#                            de session ni DDL fiable.
#
# Les deux doivent viser le meme projet, ports differents compris.
# DATABASE_POOL_MAX reste abstrait ici : il vaut 1 en hebergement a
# invocations ephemeres, car le quota de connexions compte par BASE et
# non par application.
#
# DATABASE_URL="postgresql://postgres.PROJET:MOT_DE_PASSE@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require"
# DIRECT_DATABASE_URL="postgresql://postgres:MOT_DE_PASSE@db.PROJET.supabase.co:5432/postgres?sslmode=require"
# DATABASE_POOL_MAX=1

# ---- Redis (cache, sessions, files d'attente) --------------
REDIS_URL="redis://127.0.0.1:6379/0"

# ---- Redis partage REST : limitation de debit -------------
# OBLIGATOIRE en production, l'application refuse de demarrer sans.
#
# Pourquoi c'est obligatoire, et non recommande : le stockage par
# defaut du limiteur est une Map en memoire du processus. En
# hebergement a invocations ephemeres (Vercel), chaque invocation
# repart de zero, donc la limite annoncee n'a aucun effet et le code
# OTP a six chiffres devient forcable. C'est une panne silencieuse :
# aucun test ne la detecte.
#
# Upstash expose une API REST, ce qui convient : une connexion TCP
# persistante vers Redis ne tient pas dans une fonction dont la duree
# de vie est celle d'une requete.
# https://console.upstash.com
# UPSTASH_REDIS_REST_URL="https://nom.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="a-remplacer"

# ---- Authentification --------------------------------------
# A GENERER : openssl rand -base64 48
JWT_ACCESS_SECRET="DEV-ONLY-access-secret-a-remplacer-par-une-chaine-aleatoire-de-48-octets"
JWT_REFRESH_SECRET="DEV-ONLY-refresh-secret-a-remplacer-par-une-chaine-aleatoire-de-48-octets"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Argon2id - cout, memoire et parallelisme (CDCS 12.2)
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# ---- Verification de telephone ----------------------------
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=3
SMS_PROVIDER=mock

# ---- Stockage objet ---------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./var/storage
# AWS S3 / Cloudflare R2
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# ---- CORS -------------------------------------------------
CORS_ORIGINS="http://localhost:3001,http://127.0.0.1:3001"

# ---- Observabilite (CDCS 11.8) ----------------------------
LOG_LEVEL=debug
SENTRY_DSN=
OTEL_ENABLED=false

# ---- Web (Next.js) -----------------------------------------------
# `API_INTERNAL_URL` n'est lue QUE par le serveur : c'est l'adresse
# du serveur d'API, jamais celle du navigateur.
#
# En local, l'API tourne sur le poste du developpeur. Sur Vercel, c'est
# l'URL publique de l'API deployee ailleurs — Vercel ne peut pas
# l'heberger (voir docs/adr/ADR-003).
#
# Le nom du cookie n'a pas a etre configure : il n'apparait que dans les
# reponses du serveur.
# API_INTERNAL_URL="http://127.0.0.1:3000"

# ---- Prestataire de paiement (CDCS 14) ----------------------
# Cle de signature des notifications recues.
#
# ⚠️ Elle determine QUI peut declarer un paiement recu. La divulguer
# permet de confirmer n importe quelle reservation sans avoir paye.
# Elle n est donc PAS fournie ici avec une valeur d exemple : une
# illustration fonctionnelle serait un secret deploye tel quel.
#
# 32 octets minimum (64 caracteres hexadecimaux). En dessous, le
# simulateur refuse d ouvrir des paiements plutot que de signer avec
# une cle faible : mieux vaut un service indisponible qu un service
# que n importe qui peut imiter.
#
# PAYMENT_PROVIDER_SECRET=
#
# Fenetre de tolerance d une notification, en secondes. Assez large
# pour un prestataire lent, trop etroit pour rejouer une signature
# capturee. 300 couvre un prestataire continental normal.
# PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
#
# Forcer l indisponibilite du prestataire, pour verifier le parcours
# d erreur sans attendre une panne reelle.
# PAYMENT_PROVIDER_UNAVAILABLE=false

# ---- Limitation de debit (CDCS 12.4) ---------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT_SHORT=20
THROTTLE_LIMIT_MEDIUM=100

# ---- Temps reel (A-17) -----------------------------------
# Intervalle de lecture du flux d'evenements. Plus court = plus
# reactif, et plus de requetes : 5 s est un compromis raisonnable sur
# un reseau mobile instable, qui est le cas d'usage dominant.
SSE_POLL_INTERVAL_MS=5000