# ============================================================
# AdkCars CI - variables d'environnement du developpement local
#
# Ne jamais versionner un .ENV reel. Copier ce fichier en .env :
#   cp .env.example .env   (ou Copy-Item sur Windows)
#
# Les valeurs ci-dessous sont des valeurs de developpement.
# En production, toutes les valeurs SECREtes proviennent d'un
# coffre de secrets (CDCS 12.4).
# ============================================================

# ---- Application -------------------------------------------
NODE_ENV=development
PORT=3000
APP_NAME=@adkcars/api
APP_VERSION=0.1.0
# prefixe de l'API dans les journaux structures
LOG_PREFIX=[api]

# ---- Base de donnees (portable locale, cf. scripts/dev-db.ps1)
# DATABASE_URL : role restreint utilise par l'application (CDCS 12.1)
DATABASE_URL="postgresql://adkcars:adkcars_dev@127.0.0.1:5432/adkcars_dev?schema=public&connection_limit=10&pool_timeout=20"
# DIRECT_DATABASE_URL : role privilegie, utilise UNIQUEMENT par les migrations
# (necessite CREATE EXTENSION). Ne jamais l'utiliser dans le code applicatif.
DIRECT_DATABASE_URL="postgresql://postgres:adkcars_dev@127.0.0.1:5432/adkcars_dev?schema=public"

# ---- Redis (cache, sessions, files d'attente) --------------
REDIS_URL="redis://127.0.0.1:6379/0"

# ---- Authentification --------------------------------------
# A GENERER : openssl rand -base64 48
JWT_ACCESS_SECRET="DEV-ONLY-access-secret-a-remplacer-par-une-chaine-aleatoire-de-48-octets"
JWT_REFRESH_SECRET="DEV-ONLY-refresh-secret-a-remplacer-par-une-chaine-aleatoire-de-48-octets"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Argon2id - cout, memoire et parallelisme (CDCS 12.2)
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# ---- Verification de telephone ----------------------------
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=3
SMS_PROVIDER=mock

# ---- Stockage objet ---------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./var/storage
# AWS S3 / Cloudflare R2
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# ---- CORS -------------------------------------------------
CORS_ORIGINS="http://localhost:3001,http://127.0.0.1:3001"

# ---- Observabilite (CDCS 11.8) ----------------------------
LOG_LEVEL=debug
SENTRY_DSN=
OTEL_ENABLED=false

# ---- Limitation de debit (CDCS 12.4) ---------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT_SHORT=20
THROTTLE_LIMIT_MEDIUM=100